{
  "datasets": [
    {
      "name": "ae6699b9",
      "displayName": "leaderboard",
      "queryLines": [
        "SELECT\r\n",
        "  rank_at_snapshot,\r\n",
        "  symbol,\r\n",
        "  name,\r\n",
        "  current_price,\r\n",
        "  market_cap,\r\n",
        "  price_change_percentage_24h,\r\n",
        "  ath_change_percentage\r\n",
        "FROM crypto_lakehouse.gold.dim_asset_current\r\n",
        "ORDER BY rank_at_snapshot;"
      ]
    },
    {
      "name": "2946d2f9",
      "displayName": "KPIs",
      "queryLines": [
        "WITH agg AS (\r\n",
        "  SELECT SUM(market_cap) AS market_cap_total\r\n",
        "  FROM crypto_lakehouse.gold.dim_asset_current\r\n",
        "),\r\n",
        "gainer AS (\r\n",
        "  SELECT symbol, price_change_percentage_24h\r\n",
        "  FROM crypto_lakehouse.gold.dim_asset_current\r\n",
        "  ORDER BY price_change_percentage_24h DESC\r\n",
        "  LIMIT 1\r\n",
        "),\r\n",
        "loser AS (\r\n",
        "  SELECT symbol, price_change_percentage_24h\r\n",
        "  FROM crypto_lakehouse.gold.dim_asset_current\r\n",
        "  ORDER BY price_change_percentage_24h ASC\r\n",
        "  LIMIT 1\r\n",
        "),\r\n",
        "news AS (\r\n",
        "  SELECT ROUND(100.0 * SUM(n_ok) / SUM(total_articulos), 1) AS pct_ok\r\n",
        "  FROM crypto_lakehouse.gold.news_pipeline_health\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  ROUND(agg.market_cap_total / 1e9, 1) AS market_cap_total_b,\r\n",
        "  UPPER(gainer.symbol) || ' +' || ROUND(gainer.price_change_percentage_24h, 1) || '%' AS top_gainer,\r\n",
        "  UPPER(loser.symbol)  || ' '  || ROUND(loser.price_change_percentage_24h, 1)  || '%' AS top_loser,\r\n",
        "  news.pct_ok AS pct_scraped_ok\r\n",
        "FROM agg\r\n",
        "CROSS JOIN gainer\r\n",
        "CROSS JOIN loser\r\n",
        "CROSS JOIN news;"
      ]
    },
    {
      "name": "51adc43f",
      "displayName": "Movers",
      "queryLines": [
        "SELECT\r\n",
        "  symbol,\r\n",
        "  ROUND(price_change_pct * 100, 2) AS price_change_pct\r\n",
        "FROM crypto_lakehouse.gold.asset_daily_summary\r\n",
        "ORDER BY price_change_pct DESC;"
      ]
    },
    {
      "name": "4b7f6550",
      "displayName": "news_health",
      "queryLines": [
        "SELECT\r\n",
        "  source,\r\n",
        "  n_ok,\r\n",
        "  n_bloqueado,\r\n",
        "  n_error,\r\n",
        "  n_sin_contenido\r\n",
        "FROM crypto_lakehouse.gold.news_pipeline_health;"
      ]
    },
    {
      "name": "movers_with_direction",
      "displayName": "Movers del Día con Dirección",
      "queryLines": [
        "SELECT\n",
        "  symbol,\n",
        "  price_change_pct as price_change,\n",
        "  CASE\n",
        "    WHEN price_change_pct > 0 THEN 'Suba'\n",
        "    WHEN price_change_pct < 0 THEN 'Baja'\n",
        "    ELSE 'Sin cambio'\n",
        "  END as direction\n",
        "FROM\n",
        "  crypto_lakehouse.gold.asset_daily_summary\n",
        "ORDER BY\n",
        "  price_change DESC"
      ]
    }
  ],
