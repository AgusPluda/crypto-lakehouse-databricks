# Workspace de Databricks (sin barra final)
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com

# OAuth M2M del Service Principal, con permiso Can Query solo sobre el endpoint del agente
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Nombre del Model Serving endpoint del agente
DATABRICKS_SERVING_ENDPOINT=crypto_agent_endpoint

# Opcional. Por defecto model-serving, que es el scope que hay que asignar al generar el OAuth secret.
# Si el secret tiene otro scope, poner el mismo acá.
# DATABRICKS_OAUTH_SCOPE=model-serving
